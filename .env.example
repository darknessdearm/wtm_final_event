# Firebase Realtime Database config.
#
# These are compiled into the client bundle and shipped to every visitor, so
# they are public by design (hence NEXT_PUBLIC_*) — the API key is an
# identifier, not a credential. Access is controlled by database.rules.json.
#
# Copy to `.env.local` and fill in from Firebase Console > Project settings >
# Your apps > SDK setup and configuration.
#
# All optional: with none of them set the site still builds and runs, using its
# bundled roster and item pool instead of live data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
